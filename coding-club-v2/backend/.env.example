# ─── Coding Club Backend — Environment Variables ─────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit your real .env.
# Required for both local development and production deployment.

# Server
PORT=5000
NODE_ENV=development            # use "production" on deployed servers

# PostgreSQL database (required). Example for local / Render / Railway / Neon.
DATABASE_URL=postgresql://user:password@localhost:5432/coding_club

# JWT auth (REQUIRED — set a long random string in production)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# AI code review — OpenRouter-compatible API (required for compile/submit features)
# Get a free key at https://openrouter.ai/keys
NEMOTRON_API_KEY=sk-or-v1-your-key-here
NEMOTRON_API_URL=https://openrouter.ai/api/v1/chat/completions
NEMOTRON_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# CORS — the exact URL of your deployed frontend (no trailing slash)
FRONTEND_URL=http://localhost:3000
